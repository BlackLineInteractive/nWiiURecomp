diff --git a/src/Cemu/PortMode.cpp b/src/Cemu/PortMode.cpp
new file mode 100644
index 0000000..ec06a6c
--- /dev/null
+++ b/src/Cemu/PortMode.cpp
@@ -0,0 +1,25 @@
+#include "Cemu/PortMode.h"
+
+namespace wwhd_port
+{
+std::filesystem::path default_game_path(
+	const std::filesystem::path& executable)
+{
+	return executable.parent_path() / "game" / "code" / "cking.rpx";
+}
+
+std::filesystem::path default_module_path(
+	const std::filesystem::path& executable)
+{
+	return executable.parent_path() / "libwwhd-module.so";
+}
+
+std::filesystem::path normalize_game_path(
+	const std::filesystem::path& selected)
+{
+	if (selected.filename() == "cking.rpx" &&
+		selected.parent_path().filename() == "code")
+		return selected.parent_path().parent_path();
+	return selected;
+}
+}
diff --git a/src/Cemu/PortMode.h b/src/Cemu/PortMode.h
new file mode 100644
index 0000000..13fc63c
--- /dev/null
+++ b/src/Cemu/PortMode.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string_view>
+
+namespace wwhd_port
+{
+inline constexpr uint64_t kTitleId = 0x0005000010143600ULL;
+inline constexpr uint16_t kTitleVersion = 0;
+inline constexpr std::string_view kProductName = "Wind Waker HD Recompiled";
+inline constexpr std::string_view kWindowTitle =
+	"The Legend of Zelda: The Wind Waker HD — Recompiled";
+
+struct InputPlan
+{
+	size_t gamepads;
+	bool keyboard_fallback;
+};
+
+// All physical pads are exposed to the game as Wii U Pro Controllers.
+// Cap matches InputManager::kMaxWPADControllers.
+constexpr InputPlan input_plan(size_t connected_gamepads)
+{
+	return {std::min<size_t>(connected_gamepads, 7), connected_gamepads == 0};
+}
+
+std::filesystem::path default_game_path(
+	const std::filesystem::path& executable);
+std::filesystem::path default_module_path(
+	const std::filesystem::path& executable);
+std::filesystem::path normalize_game_path(
+	const std::filesystem::path& selected);
+}
diff --git a/src/Cemu/PortMode_test.cpp b/src/Cemu/PortMode_test.cpp
new file mode 100644
index 0000000..70f448d
--- /dev/null
+++ b/src/Cemu/PortMode_test.cpp
@@ -0,0 +1,65 @@
+#include "Cemu/PortMode.h"
+#include "Cafe/HW/Espresso/Recompiler/PPCStaticRecompiler.h"
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <cassert>
+#include <filesystem>
+
+int main()
+{
+	const std::filesystem::path executable{"/opt/wwhd/wwhd-recompiled"};
+	assert(wwhd_port::default_game_path(executable) ==
+		"/opt/wwhd/game/code/cking.rpx");
+	assert(wwhd_port::default_module_path(executable) ==
+		"/opt/wwhd/libwwhd-module.so");
+	assert(wwhd_port::normalize_game_path(
+			   "/opt/wwhd/game/code/cking.rpx") == "/opt/wwhd/game");
+	assert(wwhd_port::normalize_game_path("/games/WWHD") ==
+		"/games/WWHD");
+
+	const auto none = wwhd_port::input_plan(0);
+	assert(none.gamepads == 0 && none.keyboard_fallback);
+	for (size_t count = 1; count <= 7; ++count)
+	{
+		const auto plan = wwhd_port::input_plan(count);
+		assert(plan.gamepads == count);
+		assert(!plan.keyboard_fallback);
+	}
+	assert(wwhd_port::input_plan(8).gamepads == 7);
+
+	const auto run = +[](nwiiu_static_cpu_state*,
+						 const nwiiu_static_memory*, uint64_t) -> uint32_t {
+		return NWIIU_STATIC_RESULT_EXECUTED;
+	};
+	const nwiiu_static_module valid{
+		.abi_version = NWIIU_STATIC_MODULE_ABI_VERSION,
+		.struct_size = sizeof(nwiiu_static_module),
+		.title_id = wwhd_port::kTitleId,
+		.title_version = wwhd_port::kTitleVersion,
+		.run = run,
+	};
+	std::string error;
+	assert(PPCStaticRecompiler_validateModule(
+		&valid, wwhd_port::kTitleId, wwhd_port::kTitleVersion, error));
+
+	auto wrong_abi = valid;
+	++wrong_abi.abi_version;
+	assert(!PPCStaticRecompiler_validateModule(
+		&wrong_abi, wwhd_port::kTitleId, wwhd_port::kTitleVersion, error));
+	auto wrong_title = valid;
+	++wrong_title.title_id;
+	assert(!PPCStaticRecompiler_validateModule(
+		&wrong_title, wwhd_port::kTitleId, wwhd_port::kTitleVersion, error));
+	auto wrong_version = valid;
+	++wrong_version.title_version;
+	assert(!PPCStaticRecompiler_validateModule(
+		&wrong_version, wwhd_port::kTitleId, wwhd_port::kTitleVersion, error));
+
+	assert(!PPCStaticRecompiler_initialize(
+		"/definitely/missing/libwwhd-module.so", wwhd_port::kTitleId,
+		wwhd_port::kTitleVersion, error));
+	assert(error.find("/definitely/missing/libwwhd-module.so") !=
+		std::string::npos);
+}

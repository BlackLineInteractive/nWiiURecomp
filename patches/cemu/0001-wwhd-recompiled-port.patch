diff --git a/src/Cafe/HW/Espresso/Recompiler/PPCStaticRecompiler.cpp b/src/Cafe/HW/Espresso/Recompiler/PPCStaticRecompiler.cpp
new file mode 100644
index 0000000..0137de1
--- /dev/null
+++ b/src/Cafe/HW/Espresso/Recompiler/PPCStaticRecompiler.cpp
@@ -0,0 +1,581 @@
+#include "Cafe/HW/Espresso/Recompiler/PPCStaticRecompiler.h"
+#ifndef PPC_STATIC_RECOMPILER_VALIDATION_ONLY
+#include "Cafe/HW/Espresso/PPCState.h"
+#endif
+
+#if defined(NWIIU_WWHD_PORT) && defined(__linux__)
+#ifndef PPC_STATIC_RECOMPILER_VALIDATION_ONLY
+#include "Cafe/CafeSystem.h"
+#include "Cafe/GamePatch.h"
+#include "Cemu/Logging/CemuLogging.h"
+#endif
+
+#include <fmt/format.h>
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <dlfcn.h>
+#include <mutex>
+#include <cstdlib>
+#include <unordered_map>
+#include <vector>
+
+// Instruction-level attribution. Dispatch counts cannot measure how much of the
+// guest runs natively: a one-word HLE stub and a 1,469-instruction block are
+// one dispatch each, and a single miss hides everything the host runs before
+// the next entry.
+std::atomic<uint64_t> g_nwiiuNativeInstructions{0};
+std::atomic<uint64_t> g_nwiiuJitInstructions{0};
+std::atomic<uint64_t> g_nwiiuInterpInstructions{0};
+
+namespace
+{
+const nwiiu_static_module* s_module{};
+void* s_moduleHandle{};
+#ifndef PPC_STATIC_RECOMPILER_VALIDATION_ONLY
+std::once_flag s_dispatchOnce;
+std::atomic<uint32_t> s_traceCount{};
+
+// Differential mode: the module's stores are captured instead of applied, so
+// the same block can be run again on the host interpreter from identical state
+// and the two results compared without the writes landing twice.
+struct ShadowWrite { uint32_t address; uint32_t width; uint64_t value; };
+bool shadowLoad(uint32_t address, uint32_t width, uint64_t& out);
+std::atomic<uint64_t> s_diffCompared{0};
+std::atomic<uint64_t> s_diffMiss{0};
+std::atomic<uint64_t> s_diffSkipped{0};
+std::atomic<uint64_t> s_diffOverlap{0};
+bool s_shadowActive = false;
+bool s_shadowOverlap = false;
+std::vector<ShadowWrite> s_shadowWrites;
+
+// A shadowed store must still be visible to a later load in the same block,
+// otherwise the module reads stale memory the host does not and every
+// read-after-write looks like a divergence.
+bool shadowLoad(uint32_t address, uint32_t width, uint64_t& out)
+{
+	for (size_t i = s_shadowWrites.size(); i-- > 0;)
+	{
+		const auto& w = s_shadowWrites[i];
+		if (w.address == address && w.width == width)
+		{
+			out = w.value;
+			return true;
+		}
+		// overlapping but differently sized access: fall back to memory rather
+		// than guess, and record it so the comparison can be skipped
+		const bool overlaps = address < w.address + w.width &&
+							  w.address < address + width;
+		if (overlaps)
+		{
+			s_shadowOverlap = true;
+			return false;
+		}
+	}
+	return false;
+}
+
+uint8_t read8(void*, uint32_t address)
+{
+	uint64_t v;
+	if (s_shadowActive && shadowLoad(address, 1, v)) return (uint8_t)v;
+	return memory_readU8(address);
+}
+uint16_t read16(void*, uint32_t address)
+{
+	uint64_t v;
+	if (s_shadowActive && shadowLoad(address, 2, v)) return (uint16_t)v;
+	return memory_readU16(address);
+}
+uint32_t read32(void*, uint32_t address)
+{
+	uint64_t v;
+	if (s_shadowActive && shadowLoad(address, 4, v)) return (uint32_t)v;
+	return memory_readU32(address);
+}
+uint64_t read64(void*, uint32_t address)
+{
+	uint64_t v;
+	if (s_shadowActive && shadowLoad(address, 8, v)) return v;
+	return memory_readU64(address);
+}
+void write8(void*, uint32_t address, uint8_t value)
+{
+	if (s_shadowActive) { s_shadowWrites.push_back({address, 1, value}); return; }
+	memory_writeU8(address, value);
+}
+void write16(void*, uint32_t address, uint16_t value)
+{
+	if (s_shadowActive) { s_shadowWrites.push_back({address, 2, value}); return; }
+	memory_writeU16(address, value);
+}
+void write32(void*, uint32_t address, uint32_t value)
+{
+	if (s_shadowActive) { s_shadowWrites.push_back({address, 4, value}); return; }
+	memory_writeU32(address, value);
+}
+void write64(void*, uint32_t address, uint64_t value)
+{
+	if (s_shadowActive) { s_shadowWrites.push_back({address, 8, value}); return; }
+	memory_writeU64(address, value);
+}
+void readBytes(void*, uint32_t address, uint8_t* output, uint32_t size)
+{
+	std::memcpy(output, memory_getPointerFromVirtualOffset(address), size);
+}
+void writeBytes(void*, uint32_t address, const uint8_t* input, uint32_t size)
+{
+	if (s_shadowActive)
+	{
+		for (uint32_t i = 0; i < size; ++i)
+			s_shadowWrites.push_back({address + i, 1, input[i]});
+		return;
+	}
+	std::memcpy(memory_getPointerFromVirtualOffset(address), input, size);
+}
+
+nwiiu_static_memory s_memory{
+	nullptr, &read8, &read16, &read32, &read64, &write8, &write16, &write32,
+	&write64, &readBytes, &writeBytes, nullptr, 0, nullptr, 0,
+};
+std::once_flag s_flatOnce;
+
+// memory_base is only valid once the title's memory is mapped, so the flat
+// mapping is published on first dispatch rather than at static-init time.
+const nwiiu_static_memory& staticMemory()
+{
+	std::call_once(s_flatOnce, [] {
+		if (std::getenv("NWIIU_FLAT_DISABLE") != nullptr)
+		{
+			cemuLog_log(LogType::Force, "nWiiU static memory: flat mapping disabled, using callbacks");
+			return;
+		}
+		s_memory.flat_base = memory_base;
+		s_memory.flat_size = uint64_t{1} << 32; // full reserved PPC space
+		// GamePatch_scan() has already run by first dispatch; the module must
+		// refuse blocks covering these or it executes pre-patch instructions.
+		const auto& patched = GamePatch_getPatchedAddresses();
+		s_memory.patched_addresses = patched.data();
+		s_memory.patched_count = static_cast<uint32_t>(patched.size());
+		cemuLog_log(LogType::Force,
+			"nWiiU static memory: {} host code patches published", patched.size());
+
+		cemuLog_log(LogType::Force,
+			"nWiiU static memory: flat mapping at {} ({} GiB), callbacks bypassed",
+			fmt::ptr(memory_base), s_memory.flat_size >> 30);
+	});
+	return s_memory;
+}
+
+
+// Coverage instrumentation. MISS means the module had no block for this PC and
+// Cemu's own JIT has to take over, so this is the distance to a standalone
+// recompilation. Always on: one atomic per dispatch, a map insert per miss.
+std::atomic<uint64_t> s_dispatchTotal{};
+std::atomic<uint64_t> s_missTotal{};
+std::atomic<uint64_t> s_missPartial{};
+std::mutex s_missMutex;
+std::unordered_map<uint32_t, uint64_t> s_missByPC;
+
+// Caller must hold s_missMutex.
+void reportMissStatsLocked()
+{
+	const uint64_t total = s_dispatchTotal.load();
+	const uint64_t miss = s_missTotal.load();
+	cemuLog_log(LogType::Force,
+		"nWiiU coverage: {} dispatches, {} miss ({:.2f}%), {} partial, {} distinct miss PCs",
+		total, miss,
+		total ? 100.0 * static_cast<double>(miss) / static_cast<double>(total) : 0.0,
+		s_missPartial.load(), s_missByPC.size());
+	std::vector<std::pair<uint32_t, uint64_t>> top(s_missByPC.begin(), s_missByPC.end());
+	const size_t show = std::min<size_t>(20, top.size());
+	std::partial_sort(top.begin(), top.begin() + show, top.end(),
+		[](const auto& a, const auto& b) { return a.second > b.second; });
+	uint64_t covered = 0;
+	for (size_t i = 0; i < show; ++i)
+	{
+		covered += top[i].second;
+		cemuLog_log(LogType::Force, "  miss #{:2} {:08x} x{}", i + 1,
+			top[i].first, top[i].second);
+	}
+	if (miss)
+		cemuLog_log(LogType::Force, "  top {} account for {:.1f}% of misses",
+			show, 100.0 * static_cast<double>(covered) / static_cast<double>(miss));
+	// Split by origin: only cking.rpx was statically recompiled, so anything
+	// outside its text range is system RPL code the module never saw.
+	constexpr uint32_t kGameTextLow = 0x02000000;
+	constexpr uint32_t kGameTextHigh = 0x028F90B4;
+	uint64_t inGame = 0, belowGame = 0, aboveGame = 0;
+	uint64_t inGameSites = 0, belowSites = 0, aboveSites = 0;
+	for (const auto& [pc, count] : s_missByPC)
+	{
+		if (pc < kGameTextLow) { belowGame += count; ++belowSites; }
+		else if (pc >= kGameTextHigh) { aboveGame += count; ++aboveSites; }
+		else { inGame += count; ++inGameSites; }
+	}
+	cemuLog_log(LogType::Force,
+		"  by origin: game text {} ({} PCs), below {} ({} PCs), above {} ({} PCs)",
+		inGame, inGameSites, belowGame, belowSites, aboveGame, aboveSites);
+	// Optional full dump so the residual long tail can be characterised; the
+	// top-20 list only ever shows the HLE stubs once game coverage is high.
+	if (const char* path = std::getenv("NWIIU_MISS_DUMP"))
+	{
+		if (FILE* f = fopen(path, "w"))
+		{
+			for (const auto& [pc, count] : s_missByPC)
+				fmt::print(f, "{:08x} {}\n", pc, count);
+			fclose(f);
+		}
+	}
+}
+
+void recordMiss(uint32_t pc, bool partial)
+{
+	s_missTotal.fetch_add(1);
+	if (partial)
+		s_missPartial.fetch_add(1);
+	std::scoped_lock lock(s_missMutex);
+	++s_missByPC[pc];
+	const uint64_t seen = s_missTotal.load();
+	if (seen == 1 || seen == 10000 || seen % 1000000 == 0)
+		reportMissStatsLocked();
+}
+
+
+
+nwiiu_static_cpu_state importState(PPCInterpreter_t* cpu)
+{
+	nwiiu_static_cpu_state state{};
+	std::copy_n(cpu->gpr, 32, state.gpr);
+	for (size_t index = 0; index < 32; ++index)
+	{
+		state.fpr[index][0] = cpu->fpr[index].fp0int;
+		state.fpr[index][1] = cpu->fpr[index].fp1int;
+	}
+	for (size_t field = 0; field < 8; ++field)
+	{
+		for (size_t bit = 0; bit < 4; ++bit)
+			state.cr[field] |= (cpu->cr[field * 4 + bit] & 1) << (3 - bit);
+	}
+	state.xer = PPCInterpreter_getXER(cpu);
+	state.lr = cpu->spr.LR;
+	state.ctr = cpu->spr.CTR;
+	state.pc = cpu->instructionPointer;
+	state.fpscr = cpu->fpscr;
+	state.reservation_address = cpu->reservedMemAddr;
+	state.reservation_value = cpu->reservedMemValue;
+	state.reservation_valid = cpu->reservedMemAddr != 0;
+	return state;
+}
+
+void exportState(PPCInterpreter_t* cpu, const nwiiu_static_cpu_state& state)
+{
+	std::copy_n(state.gpr, 32, cpu->gpr);
+	for (size_t index = 0; index < 32; ++index)
+	{
+		cpu->fpr[index].fp0int = state.fpr[index][0];
+		cpu->fpr[index].fp1int = state.fpr[index][1];
+	}
+	for (size_t field = 0; field < 8; ++field)
+	{
+		for (size_t bit = 0; bit < 4; ++bit)
+			cpu->cr[field * 4 + bit] = (state.cr[field] >> (3 - bit)) & 1;
+	}
+	PPCInterpreter_setXER(cpu, state.xer);
+	cpu->spr.LR = state.lr;
+	cpu->spr.CTR = state.ctr;
+	cpu->instructionPointer = state.pc;
+	cpu->fpscr = state.fpscr;
+	cpu->reservedMemAddr = state.reservation_valid ? state.reservation_address : 0;
+	// Carry the value captured at lwarx. Re-reading memory here would hand the
+	// host a fresh value and make every stwcx. succeed, destroying atomicity.
+	cpu->reservedMemValue = state.reservation_valid ? state.reservation_value : 0;
+}
+#endif
+}
+
+bool PPCStaticRecompiler_validateModule(
+	const nwiiu_static_module* module, uint64_t expected_title,
+	uint16_t expected_version, std::string& error)
+{
+	if (module == nullptr)
+		error = "static module entry returned null";
+	else if (module->abi_version != NWIIU_STATIC_MODULE_ABI_VERSION)
+		error = fmt::format("static module ABI {} does not match {}",
+			module->abi_version, NWIIU_STATIC_MODULE_ABI_VERSION);
+	else if (module->struct_size < sizeof(nwiiu_static_module))
+		error = "static module descriptor is too small";
+	else if (module->run == nullptr)
+		error = "static module has no run entry point";
+	else if (module->title_id != expected_title)
+		error = fmt::format("static module title {:016x} does not match {:016x}",
+			module->title_id, expected_title);
+	else if (module->title_version != expected_version)
+		error = fmt::format(
+			"static module title version {} does not match {}",
+			module->title_version, expected_version);
+	else
+		return true;
+	return false;
+}
+
+bool PPCStaticRecompiler_initialize(const std::filesystem::path& path,
+	uint64_t expected_title, uint16_t expected_version, std::string& error)
+{
+	if (s_module != nullptr)
+	{
+		if (s_module->title_id == expected_title &&
+			s_module->title_version == expected_version)
+			return true;
+		error = "a static module for another title or version is already loaded";
+		return false;
+	}
+
+	void* handle = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+	if (handle == nullptr)
+	{
+		error = fmt::format("{}: {}", path.string(), dlerror());
+		return false;
+	}
+
+	dlerror();
+	using Entry = const nwiiu_static_module* (*)();
+	const auto entry = reinterpret_cast<Entry>(
+		dlsym(handle, "nwiiu_static_module_v1"));
+	if (const char* symbol_error = dlerror(); symbol_error != nullptr)
+	{
+		error = fmt::format("{}: {}", path.string(), symbol_error);
+		dlclose(handle);
+		return false;
+	}
+
+	std::string validation_error;
+	const nwiiu_static_module* module = entry();
+	if (!PPCStaticRecompiler_validateModule(
+			module, expected_title, expected_version, validation_error))
+	{
+		error = fmt::format("{}: {}", path.string(), validation_error);
+		dlclose(handle);
+		return false;
+	}
+
+	s_moduleHandle = handle;
+	s_module = module;
+#ifndef PPC_STATIC_RECOMPILER_VALIDATION_ONLY
+	cemuLog_log(LogType::Force,
+		"nWiiU static module loaded for title {:016x} version {}",
+		module->title_id, module->title_version);
+#endif
+	return true;
+}
+
+#ifndef PPC_STATIC_RECOMPILER_VALIDATION_ONLY
+// Diagnostic: the module hardcodes GQR2..5 as U8/U16/S8/S16 with scale zero and
+// never sees the real registers, so print what the guest actually programmed.
+// Differential check: run one block on the module with its stores shadowed,
+// rewind, run the identical instructions on the host interpreter, and report
+// the first place the two disagree. This is the only comparison that survives
+// the emulation being non-deterministic run to run, because both sides start
+// from the same state in the same run.
+bool nwiiuDifferentialStep(PPCInterpreter_t* cpu)
+{
+	const PPCInterpreter_t before = *cpu;
+
+	s_shadowWrites.clear();
+	s_shadowOverlap = false;
+	s_shadowActive = true;
+	auto state = importState(cpu);
+	const uint32_t result = s_module->run(
+		&state, &staticMemory(), static_cast<uint64_t>(cpu->remainingCycles));
+	s_shadowActive = false;
+	if (result != NWIIU_STATIC_RESULT_EXECUTED || state.instruction_count == 0)
+	{
+		s_diffMiss.fetch_add(1);
+		return false; // nothing to compare, let the caller fall through
+	}
+	if (s_shadowOverlap)
+	{
+		s_diffOverlap.fetch_add(1);
+		// mixed-width access to a shadowed store; cannot model it faithfully
+		for (const auto& w : s_shadowWrites)
+			switch (w.width)
+			{
+			case 1: memory_writeU8(w.address, (uint8)w.value); break;
+			case 2: memory_writeU16(w.address, (uint16)w.value); break;
+			case 4: memory_writeU32(w.address, (uint32)w.value); break;
+			default: memory_writeU64(w.address, w.value); break;
+			}
+		exportState(cpu, state);
+		cpu->remainingCycles -= (sint32)std::min<uint64_t>(state.instruction_count, INT32_MAX);
+		return true;
+	}
+
+	auto moduleWrites = s_shadowWrites;
+	PPCInterpreter_t moduleCpu = *cpu;
+	exportState(&moduleCpu, state);
+
+	// Rewind and replay the same instruction count on the host. Only compare
+	// when both engines land on the same PC after the same number of steps:
+	// anything else means the two runs are not aligned (the interpreter charges
+	// a whole HLE call as one step, and matching on PC alone lets it arrive by
+	// a different path), and an unaligned comparison reports noise.
+	*cpu = before;
+	for (uint64_t i = 0; i < state.instruction_count; ++i)
+		PPCInterpreterSlim_executeInstruction(cpu);
+	// Rewinding restored the pre-block cycle count and the host replay charges
+	// none of its own, so without this the slice never ends: the caller loops
+	// here forever, the thread never yields, and the harness reports a single
+	// entry no matter how long it runs.
+	cpu->remainingCycles -= static_cast<sint32>(
+		std::min<uint64_t>(state.instruction_count, INT32_MAX));
+	if (cpu->instructionPointer != moduleCpu.instructionPointer)
+	{
+		s_diffSkipped.fetch_add(1);
+		return true; // not comparable, say nothing
+	}
+	s_diffCompared.fetch_add(1);
+
+	std::string diff;
+	for (int i = 0; i < 32; ++i)
+		if (cpu->gpr[i] != moduleCpu.gpr[i])
+			diff += fmt::format(" r{} host={:08x} module={:08x}", i,
+				cpu->gpr[i], moduleCpu.gpr[i]);
+	for (int i = 0; i < 32; ++i)
+		if (cpu->fpr[i].fp0int != moduleCpu.fpr[i].fp0int ||
+			cpu->fpr[i].fp1int != moduleCpu.fpr[i].fp1int)
+			diff += fmt::format(" f{} host={:016x}/{:016x} module={:016x}/{:016x}",
+				i, cpu->fpr[i].fp0int, cpu->fpr[i].fp1int,
+				moduleCpu.fpr[i].fp0int, moduleCpu.fpr[i].fp1int);
+	// XER, FPSCR and the reservation were never compared, so a divergence in
+	// carry, overflow, rounding state or atomicity left no trace.
+	if (PPCInterpreter_getXER(cpu) != PPCInterpreter_getXER(&moduleCpu))
+		diff += fmt::format(" xer host={:08x} module={:08x}",
+			PPCInterpreter_getXER(cpu), PPCInterpreter_getXER(&moduleCpu));
+	if (cpu->fpscr != moduleCpu.fpscr)
+		diff += fmt::format(" fpscr host={:08x} module={:08x}",
+			cpu->fpscr, moduleCpu.fpscr);
+	if (cpu->reservedMemAddr != moduleCpu.reservedMemAddr ||
+		cpu->reservedMemValue != moduleCpu.reservedMemValue)
+		diff += fmt::format(" resv host={:08x}/{:08x} module={:08x}/{:08x}",
+			cpu->reservedMemAddr, cpu->reservedMemValue,
+			moduleCpu.reservedMemAddr, moduleCpu.reservedMemValue);
+	if (cpu->spr.LR != moduleCpu.spr.LR)
+		diff += fmt::format(" lr host={:08x} module={:08x}", cpu->spr.LR, moduleCpu.spr.LR);
+	if (cpu->spr.CTR != moduleCpu.spr.CTR)
+		diff += fmt::format(" ctr host={:08x} module={:08x}", cpu->spr.CTR, moduleCpu.spr.CTR);
+	for (int i = 0; i < 32; ++i)
+		if (cpu->cr[i] != moduleCpu.cr[i])
+			{ diff += fmt::format(" cr{}", i); break; }
+	// Memory is deliberately not compared: an address written more than once in
+	// the window makes "module's shadowed value" versus "final memory" a false
+	// mismatch. Registers are unambiguous at an aligned endpoint.
+	if (!diff.empty())
+	{
+		static std::atomic<uint32_t> reported{0};
+		if (reported.fetch_add(1) < 12)
+			cemuLog_log(LogType::Force,
+				"nWiiU DIVERGENCE at {:08x} after {} instr:{}",
+				before.instructionPointer, state.instruction_count, diff);
+	}
+	return true;
+}
+
+bool PPCStaticRecompiler_attemptEnter(PPCInterpreter_t* cpu)
+{
+	// Diagnostic kill switch: forces every block through Cemu's own JIT so the
+	// recompiled module can be compared against a known-good reference.
+	static const bool disabled = std::getenv("NWIIU_STATIC_DISABLE") != nullptr;
+	if (disabled)
+		return false;
+	if (s_module == nullptr || cpu->remainingCycles <= 0 ||
+		CafeSystem::GetForegroundTitleId() != s_module->title_id)
+		return false;
+
+	static const bool differential = std::getenv("NWIIU_DIFF") != nullptr;
+	if (differential)
+	{
+		static std::atomic<uint64_t> entries{0};
+		if ((entries.fetch_add(1) % 100000) == 0)
+			cemuLog_log(LogType::Force,
+				"nWiiU diffstats: entries={} compared={} misaligned={} overlap={} miss={}",
+				entries.load(), s_diffCompared.load(), s_diffSkipped.load(),
+				s_diffOverlap.load(), s_diffMiss.load());
+		bool any = false;
+		while (cpu->remainingCycles > 0 && nwiiuDifferentialStep(cpu))
+			any = true;
+		return any;
+	}
+
+	bool executed = false;
+	uint64_t blocksThisEntry = 0;
+	while (cpu->remainingCycles > 0)
+	{
+		s_dispatchTotal.fetch_add(1);
+		auto state = importState(cpu);
+		// A block is refused when it does not fit in what is left of the
+		// quantum, which at the tail of every timeslice sends an otherwise
+		// perfectly good block to the host. Overshooting by at most one block
+		// is harmless: the scheduler ends the slice on the next check anyway.
+		// 2048 sits above the largest generated block (1469 instructions) so none is
+		// ever refused for want of budget; set to 0 to restore the strict behaviour.
+		static const uint64_t slack = [] {
+			const char* raw = std::getenv("NWIIU_BUDGET_SLACK");
+			return raw ? std::strtoull(raw, nullptr, 0) : 2048ull;
+		}();
+		const uint32_t result = s_module->run(
+			&state, &staticMemory(),
+			static_cast<uint64_t>(cpu->remainingCycles) + slack);
+		const uint32_t trace = s_traceCount.fetch_add(1);
+		if (trace < 32)
+			cemuLog_log(LogType::Force,
+				"nWiiU static step {:08x} -> {:08x}, result {}, instructions {}",
+				cpu->instructionPointer, state.pc, result, state.instruction_count);
+		if (result == NWIIU_STATIC_RESULT_MISS)
+		{
+			recordMiss(cpu->instructionPointer, state.instruction_count != 0);
+			return executed;
+		}
+		if (result != NWIIU_STATIC_RESULT_EXECUTED)
+		{
+			cemuLog_log(LogType::Force, "nWiiU static module fault at {:08x}", cpu->instructionPointer);
+			std::terminate();
+		}
+		std::call_once(s_dispatchOnce, [&] {
+			cemuLog_log(LogType::Force,
+				"nWiiU static execution entered at {:08x}", cpu->instructionPointer);
+		});
+		exportState(cpu, state);
+		g_nwiiuNativeInstructions.fetch_add(state.instruction_count,
+			std::memory_order_relaxed);
+		{
+			static std::atomic<uint64> tick{0};
+			if ((tick.fetch_add(1, std::memory_order_relaxed) % 2000000) == 0)
+			{
+				const uint64 nat = g_nwiiuNativeInstructions.load();
+				const uint64 jit = g_nwiiuJitInstructions.load();
+				const uint64 itp = g_nwiiuInterpInstructions.load();
+				const uint64 all = nat + jit + itp;
+				cemuLog_log(LogType::Force,
+					"nWiiU instr: native {}, JIT {}, interp {} -> {:.3f}% recompiled",
+					nat, jit, itp,
+					all ? 100.0 * (double)nat / (double)all : 0.0);
+			}
+		}
+		cpu->remainingCycles -= static_cast<sint32>(
+			std::min<uint64_t>(state.instruction_count, INT32_MAX));
+		executed = true;
+		// Diagnostic: cap consecutive blocks per entry to find where staying
+		// inside the module starts diverging from the host's dispatch cadence.
+		static const uint64_t maxBlocks = [] {
+			const char* raw = std::getenv("NWIIU_MAX_BLOCKS");
+			return raw ? std::strtoull(raw, nullptr, 0) : 0ull;
+		}();
+		if (maxBlocks != 0 && ++blocksThisEntry >= maxBlocks)
+			return executed;
+	}
+	return executed;
+}
+#endif
+#else
+bool PPCStaticRecompiler_attemptEnter(PPCInterpreter_t*) { return false; }
+#endif

+#ifdef NWIIU_WWHD_PORT
+void InputManager::configure_port_input()
+{
+	std::scoped_lock reconcile_lock(m_port_input_mutex);
+	auto physical = get_api_provider(InputAPI::SDLController)->get_controllers();
+	const auto plan = wwhd_port::input_plan(physical.size());
+	cemuLog_log(LogType::Force, "WWHD input: {} SDL gamepad(s){}",
+				plan.gamepads,
+				plan.keyboard_fallback ? ", keyboard fallback" : "");
+
+	for (size_t player = 0; player < kMaxController; ++player)
+		delete_controller(player, false);
+
+	if (plan.keyboard_fallback)
+	{
+		auto keyboards =
+			get_api_provider(InputAPI::Keyboard)->get_controllers();
+		if (!keyboards.empty())
+		{
+			auto emulated = set_controller(
+				0, EmulatedController::Type::VPAD, keyboards.front());
+			emulated->set_default_mapping(keyboards.front());
+		}
+		return;
+	}
+
+	for (size_t player = 0; player < plan.gamepads; ++player)
+	{
+		auto emulated = set_controller(
+			player, EmulatedController::Type::Pro, physical[player]);
+		cemuLog_log(LogType::Force,
+					"WWHD input: player {} -> Wii U Pro Controller ({})",
+					player, physical[player]->display_name());
+		physical[player]->set_rumble(1.0f);
+		physical[player]->set_use_motion(physical[player]->has_motion());
+		emulated->set_default_mapping(physical[player]);
+	}
+}
+#endif
